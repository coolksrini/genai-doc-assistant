# LLM Configuration (Ollama default — change base_url + api_key for OpenAI/Groq)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Embedding Configuration
EMBED_MODEL=nomic-embed-text

# Vector Store
CHROMA_PATH=./data/chroma_db

# Upload Limits
MAX_FILE_SIZE_MB=10

# Chunking
CHUNK_SIZE=200
CHUNK_OVERLAP=20
